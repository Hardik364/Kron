# Copy this file to .env.dev and set your preferred values.
# .env.dev is gitignored — never commit credentials.
#
# Usage:
#   cp .env.dev.example .env.dev
#   ./scripts/dev-up.sh

# ClickHouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_PASSWORD=kron-dev-password

# Redpanda
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644

# MinIO (S3-compatible object storage for Parquet cold storage)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=kron
MINIO_ROOT_PASSWORD=kron-dev-password

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
